# ==============================================================================
# 🔴 أسرار — ولا واحد من هدول بينرفع أبدا
# ==============================================================================
.env
.env.*
!.env.example

# مفاتيح وشهادات
*.pem
*.key
*.p12
*.pfx
*.crt

# 🔴 .npmrc ممكن يحتوي توكن دخول لمستودع حزم خاص
.npmrc

# 🔴 نسخ قاعدة البيانات — بعد البايلوت رح تحتوي أرقام تلفونات
#    وطلبات زباين حقيقيين. تسريبها أخطر من تسريب الكود.
*.dump
*.sql.bak
*.backup
*.sql.gz
dumps/

# ==============================================================================
# مخرجات بناء وملفات مؤقتة — بتتولد لحالها، ما إلها داعي بجيت
# ==============================================================================
node_modules/
dist/
build/
.next/
coverage/
*.tsbuildinfo
.turbo/
.cache/
tmp/
.pnpm-store/

# ==============================================================================
# ملفات النظام والمحررات
# ==============================================================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~

# بقايا تعارضات الدمج — بتنعمل لما merge يفشل، وبتنرفع بالغلط كتير
*.orig
*.rej

# ==============================================================================
# سجلات
# ==============================================================================
*.log
npm-debug.log*
pnpm-debug.log*

# النسخة الملغاة من تصميم النظام — للأرشيف عند الفاوندر، ما بتنرفع.
# السبب مش الحجم (٤.٢ ميغا) — إنه حدا بالفريق بيفتحها ويشتغل على تصميم ملغي.
docs/*ARCHIVED*
.claude/
