flowchart TB
    classDef ext fill:#E1EAEE,stroke:#35555F,stroke-width:1px,color:#161615
    classDef sys fill:#0E7C7B,stroke:#0A5F5E,stroke-width:2px,color:#FFFFFF
    classDef defer fill:#F2F2F0,stroke:#8A8A85,stroke-width:1px,stroke-dasharray:5 3,color:#5A5A57

    CUST(["Customer<br/><i>orders by WhatsApp text</i>"]):::ext
    STAFF(["Restaurant Staff / Owner<br/><i>operates the dashboard</i>"]):::ext
    TEAM(["Sufria team<br/><i>onboards each restaurant</i>"]):::ext
    META(["Meta — WhatsApp Cloud API<br/><i>message delivery</i>"]):::ext
    PAY(["Payment Provider<br/><i>deferred — cash only today</i>"]):::defer
    MON(["Error and uptime monitoring<br/><i>planned — NFR-05</i>"]):::defer

    SUFRIA["<b>SUFRIA PLATFORM</b><br/>conversational ordering,<br/>order management<br/><i>(analytics deferred)</i>"]:::sys

    CUST -- "numbered text messages" --> META
    META -- "webhook (signed)" --> SUFRIA
    SUFRIA -- "replies and status messages" --> META
    META -- "message delivery" --> CUST

    STAFF -- "sign-in, status changes" --> SUFRIA
    SUFRIA -- "orders and conversations" --> STAFF
    TEAM -- "configuration (script)" ---> SUFRIA

    SUFRIA -. "payment, refund" .-> PAY
    PAY -. "confirmation" .-> SUFRIA

    SUFRIA -. "errors, health" .-> MON
