flowchart TB
    classDef actor fill:#FCE8D6,stroke:#8A4A0A,stroke-width:1px,color:#161615
    classDef uc fill:#FFFFFF,stroke:#0E7C7B,stroke-width:1px,color:#161615
    classDef part fill:#FFFFFF,stroke:#8A4A0A,stroke-width:1.5px,color:#161615
    classDef prog fill:#FBEAB0,stroke:#7A5C06,stroke-width:1px,stroke-dasharray:5 3,color:#161615
    classDef defer fill:#F2F2F0,stroke:#8A8A85,stroke-width:1px,stroke-dasharray:5 3,color:#5A5A57

    C(["Customer"]):::actor

    subgraph ORDERING["Conversational ordering — the customer's whole surface, in WhatsApp text"]
        U5["Start a conversation<br/>and receive the menu<br/><b>FR-05</b> · built"]:::uc
        U6["Build the cart<br/>with item numbers<br/><b>FR-06</b> · built"]:::uc
        U9["Choose pickup<br/>or delivery<br/><b>FR-09</b> · built"]:::uc
        U7["Review the summary<br/>and confirm<br/><b>FR-07</b> · built"]:::uc
        U10["Pay in cash<br/><b>FR-10</b> · partially built"]:::part
        U22["Told the restaurant<br/>is closed<br/><b>FR-22</b> · built"]:::uc
        U25["Start over after<br/>60 minutes of silence<br/><b>FR-25</b> · built"]:::uc
        U28["Told ordering<br/>is paused<br/><b>FR-28</b> · built"]:::uc
        U8["Repeat the last order<br/>in one word<br/><b>FR-08</b> · built"]:::uc
        U15["Pay online<br/><b>FR-15</b> · deferred"]:::defer
    end

    C --> U5
    C --> U6
    C --> U9
    C --> U7
    C --> U10
    U5 -. "extended by — outside opening hours" .- U22
    U5 -. "extended by — silent session" .- U25
    U6 -. "extended by — at any step while paused" .- U28
    U5 -. "extended by — returning customer" .- U8
    U10 -. "online option" .- U15
