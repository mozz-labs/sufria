flowchart TB
    classDef svc fill:#E1EAEE,stroke:#35555F,stroke-width:2px,color:#161615
    classDef mod fill:#FFFFFF,stroke:#8A8A85,color:#161615
    classDef shared fill:#EDE6F7,stroke:#5B3A99,color:#161615
    classDef db fill:#DCEEDC,stroke:#24632F,stroke-width:2px,color:#161615
    classDef ext fill:#F5DEDD,stroke:#8A332F,color:#161615
    classDef defer fill:#F2F2F0,stroke:#8A8A85,stroke-width:1px,stroke-dasharray:5 3,color:#5A5A57

    subgraph REPO["sufria — single repository (pnpm workspaces) · three processes"]
        direction TB

        subgraph WEB["apps/dashboard-web — Next.js 16 · port 3000"]
            W1["Live orders and history"]:::mod
            W2["Order details<br/>with the conversation"]:::mod
            W3["Login and session gate"]:::mod
            W4["API client<br/><i>polling every 10 s</i>"]:::mod
        end

        subgraph SHARED["packages/shared — @sufria/shared"]
            SH1["Drizzle schema mirror"]:::shared
            SH2["Customer-facing texts,<br/>normaliser, item parser"]:::shared
            SH3["STAFF_TRANSITIONS,<br/>API contracts"]:::shared
        end

        subgraph ENGINE["apps/conversation-engine — node:http · port 3001"]
            E1["Webhook route<br/><i>HMAC on the raw body + Zod</i>"]:::mod
            E2["WebhookService<br/><i>dedup gate · routing ·<br/>one transaction per message</i>"]:::mod
            E3["ConversationService<br/><i>idle expiry · opening hours ·<br/>state router</i>"]:::mod
            E4["State handlers<br/><i>browsing · fulfilment ·<br/>cart review</i>"]:::mod
            E5["Order creation<br/><i>availability re-check · CAS</i>"]:::mod
            E6["Sender<br/><i>text only · saved to<br/>outbound_messages</i>"]:::mod
            E7["OrderNotifier<br/><i>every 5 s</i>"]:::mod
        end

        subgraph API["apps/dashboard-api — NestJS 11 · port 3002"]
            A1["JwtAuthGuard"]:::mod
            A2["RestaurantContextGuard"]:::mod
            A3["TenantDbService<br/><i>sole data path</i>"]:::mod
            A4["Orders<br/><i>list · detail · messages · status</i>"]:::mod
            A5["Menu items · Settings"]:::mod
            A6["Auth<br/><i>login · refresh · logout</i>"]:::mod
        end
    end

    DB[("PostgreSQL 16<br/>15 tables · RLS on 13<br/>4 SECURITY DEFINER functions")]:::db
    META["Meta WhatsApp Cloud API"]:::ext
    PAY["Payment Provider<br/><i>deferred</i>"]:::defer

    W4 -->|"REST + JWT + x-restaurant-id"| A1
    A1 --> A2 --> A3
    A4 & A5 & A6 --> A3
    A3 -->|"set_config(..., true) then query"| DB

    META -->|"inbound webhook"| E1
    E1 --> E2 --> E3 --> E4 --> E5
    E4 --> E6
    E7 --> E6
    E6 -->|"outbound text"| META
    E2 --> DB
    E5 --> DB
    E7 --> DB
    PAY -.->|"payment webhook (deferred)"| E1

    SHARED -.->|"imported by"| ENGINE
    SHARED -.->|"imported by"| API
    SHARED -.->|"imported by"| WEB
