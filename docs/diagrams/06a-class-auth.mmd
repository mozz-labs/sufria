classDiagram
    direction TB
    note for RestaurantContextGuard "The ordering below IS the security property.<br/>Step 3 before step 2 would let the caller<br/>nominate their own tenant."

    class AuthController {
        +login(dto) LoginResult
        +refresh(dto) AccessToken
        +logout() void
    }
    class AuthService {
        +login(phoneOrEmail, password) LoginResult
        +refresh(token) AccessToken
        +logout(staffAccountId) void
        -membershipsOf(staffAccountId) Restaurant[]
        -issue(staffAccountId) TokenPair
        -storeRefreshToken(staffAccountId, token) void
    }
    class JwtAuthGuard {
        <<global guard>>
        +canActivate(ctx) boolean
    }
    class RestaurantContextGuard {
        -TenantDbService tenantDb
        +canActivate(ctx) boolean
    }
    class GuardedController {
        <<orders · menu-items · restaurant/settings>>
        +handler(@VerifiedRestaurantId restaurantId)
    }
    class TenantDbService {
        -Pool pool
        -assertNotSuperuser() void
        +runInTenant(restaurantId, work) T
        +runUnscoped(work) T
    }

    AuthController --> AuthService
    AuthService --> TenantDbService : runUnscoped · app.restaurants_for_staff()
    JwtAuthGuard --> RestaurantContextGuard : 1 · who is calling
    RestaurantContextGuard --> TenantDbService : 2 · may they act here · app.verify_membership()
    RestaurantContextGuard --> GuardedController : sets the verified restaurant id
    GuardedController --> TenantDbService : 3 · what they can see · runInTenant()
