classDiagram
    direction TB
    note for WebhookService "No authenticated user exists here.<br/>The restaurant is resolved from the phone id,<br/>then the same RLS context applies."

    class WebhookServer {
        <<module http/server.ts>>
        +GET /webhooks/whatsapp
        +POST /webhooks/whatsapp
        +GET /health
    }
    class WebhookService {
        -TenantDb db
        +ingest(parsed) IngestOutcome[]
        -ingestOne(message) IngestOutcome
    }
    class ConversationService {
        +handleInbound(tx, message) void
        -readRestaurant(tx)
        -findActiveSession(tx, phone)
        -expireSession(tx, session)
        -upsertCustomer(tx, phone)
        -openSession(tx, customerId)
    }
    class StateHandlers {
        <<functions>>
        +handleBrowsingMessage()
        +handleFulfillmentMessage()
        +handleCartReviewMessage()
    }
    class OpeningHoursAndMenu {
        <<functions>>
        +decideHours(hours, timezone, now)
        +prepareMenu(tx, restaurant)
        +deliverMenu(tx, sender, session)
    }
    class CriticalPrimitives {
        <<module>>
        +claimWebhookEvent(tx, eventId, source) boolean
        +advanceSessionState(tx, id, from, to) boolean
    }

    WebhookServer --> WebhookService : after the HMAC check
    WebhookService --> CriticalPrimitives : dedup gate first
    WebhookService --> ConversationService
    ConversationService --> OpeningHoursAndMenu
    ConversationService --> StateHandlers
    StateHandlers --> CriticalPrimitives : CAS on the session state
