classDiagram
    direction TB
    note for SharedRules "Used by BOTH the API and the web app,<br/>so the button the staff sees and the rule<br/>the server enforces are the same table."

    class OrdersController {
        +list(tab, page) OrderListItem[]
        +detail(id) OrderDetail
        +messages(id) ConversationMessage[]
        +changeStatus(id, dto) OrderListItem
    }
    class OrdersService {
        -TenantDbService db
        +list(restaurantId, tab, page)
        +detail(restaurantId, id)
        +messages(restaurantId, id)
        +changeStatus(restaurantId, staffId, id, change) StatusChangeOutcome
    }
    class SharedRules {
        <<package @sufria/shared>>
        +STAFF_TRANSITIONS
        +canStaffTransition(from, to) boolean
        +MAX_CANCELLATION_REASON_LENGTH = 300
        +ORDER_STATUS_LABEL_AR
    }
    class TenantDbService {
        +runInTenant(restaurantId, work) T
    }
    class OtherControllers {
        <<menu-items · restaurant/settings>>
        +list() / get()
        +update(dto)
    }

    OrdersController --> OrdersService
    OrdersService ..> SharedRules : canStaffTransition
    OrdersService --> TenantDbService
    OtherControllers --> TenantDbService : same single data path
