{
  "name": "sufria",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "db:up": "docker compose up -d && node scripts/wait-for-db.mjs",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "test:security": "node --env-file-if-exists=.env scripts/test-security.mjs",
    "test:db": "tsx --env-file-if-exists=.env tests/db/critical-primitives.verify.ts && tsx --env-file-if-exists=.env tests/db/schema-drift.verify.ts && node --env-file-if-exists=.env --test tests/db/migrate.test.mjs",
    "test": "pnpm test:security && pnpm test:db && pnpm -r test",
    "typecheck": "tsc -b --pretty && pnpm --filter @sufria/dashboard-web typecheck",
    "lint": "eslint . --max-warnings 0 && pnpm --filter @sufria/dashboard-web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:contrast": "tsc -b packages/shared && node scripts/check-contrast.mjs",
    "check:numerals": "tsc -b packages/shared && node scripts/check-numerals.mjs",
    "check:rtl": "node scripts/check-rtl.mjs",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:contrast && pnpm check:numerals && pnpm check:rtl && pnpm test",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.1",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
