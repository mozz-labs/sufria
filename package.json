{
  "name": "wafa",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "db:up": "docker compose up -d && node scripts/wait-for-db.mjs",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "test:security": "node scripts/test-security.mjs",
    "test:db": "tsx tests/db/critical-primitives.verify.ts && tsx tests/db/schema-drift.verify.ts",
    "test": "pnpm test:security && pnpm test:db && pnpm -r test",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
