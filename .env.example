# ==============================================================================
# انسخ هذا الملف لـ .env وعبّيه. ملف .env نفسه لا يُرفع على جيت أبدا.
#   cp .env.example .env
# ==============================================================================

# --- قاعدة البيانات ------------------------------------------------------------
# محليا: بيطابق docker-compose.yml بالضبط، ما بدك تغيّر إشي
# ⚠️ المستخدم لازم يكون sufria_dashboard أو sufria_engine — مش postgres.
#    دور superuser بيلغي كل سياسات RLS بصمت. التطبيق بيرفض يقلع لو صار.
DATABASE_URL=postgres://sufria_dashboard:devpass@localhost:5432/sufria
ENGINE_DATABASE_URL=postgres://sufria_engine:devpass@localhost:5432/sufria

# للـmigrations فقط (بيحتاج صلاحيات إنشاء). مش للتطبيق.
MIGRATION_DATABASE_URL=postgres://postgres:devpass@localhost:5432/sufria

PG_POOL_MAX=10

# --- Auth ---------------------------------------------------------------------
# ولّد واحد جديد لكل بيئة:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_local_dev_only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- WhatsApp Cloud API -------------------------------------------------------
# من developers.facebook.com بعد إضافة منتج WhatsApp للتطبيق
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# نص بتخترعه إنت، وبتحطه بنفس الوقت بإعدادات الـwebhook عند ميتا
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# من إعدادات التطبيق عند ميتا — بيستخدم للتحقق من توقيع الـwebhook
WHATSAPP_APP_SECRET=

# --- بوابة الدفع (Sprint 2، فاضية لحد وقتها) -----------------------------------
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# --- عام ----------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
ENGINE_PORT=3001
DASHBOARD_API_PORT=3002
DASHBOARD_WEB_PORT=3000
